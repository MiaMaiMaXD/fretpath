-- Shared pgTAP helpers. Included from every test file with `\ir helpers/auth.psql`
-- INSIDE the file's transaction, so nothing persists after rollback.
create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

create or replace function tests.create_user(p_email text, p_role user_role default 'member')
returns uuid language plpgsql security definer set search_path = public, extensions, pg_temp as $$
declare v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
    raw_app_meta_data, raw_user_meta_data, created_at, updated_at,
    confirmation_token, recovery_token, email_change_token_new, email_change)
  values (
    '00000000-0000-0000-0000-000000000000', v_id, 'authenticated', 'authenticated',
    p_email, extensions.crypt('password123', extensions.gen_salt('bf')), now(),
    '{"provider":"email","providers":["email"]}', '{}', now(), now(), '', '', '', '');
  insert into public.profiles (id, role) values (v_id, p_role)
    on conflict (id) do update set role = p_role;
  return v_id;
end $$;

create or replace function tests.authenticate_as(p_user uuid)
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_user, 'role', 'authenticated')::text, true);
  set local role authenticated;
end $$;

create or replace function tests.authenticate_anon()
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  set local role anon;
end $$;

create or replace function tests.clear_auth()
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '', true);
  set local role postgres;
end $$;

create or replace function tests.make_lesson(
  p_course uuid, p_sort int, p_status content_status default 'published',
  p_pass int default 60, p_questions int default 5)
returns uuid language plpgsql security definer set search_path = public, extensions, pg_temp as $$
declare
  v_lesson uuid := gen_random_uuid();
  v_q uuid; v_first uuid; v_c uuid;
begin
  insert into public.lessons (id, course_id, slug, title, summary, sort_order, pass_score, status)
  values (v_lesson, p_course, 'lesson-' || replace(v_lesson::text, '-', ''),
          'Lesson ' || p_sort, 'Summary', p_sort, p_pass, 'draft');
  insert into public.lesson_contents (lesson_id, content_md, video_url)
  values (v_lesson, '# Content ' || p_sort, null);
  for i in 1..p_questions loop
    v_q := gen_random_uuid();
    insert into public.quiz_questions (id, lesson_id, prompt, explanation, sort_order)
    values (v_q, v_lesson, 'Question ' || i, 'Explanation ' || i, i);
    v_first := null;
    for j in 1..3 loop
      v_c := gen_random_uuid();
      insert into public.quiz_choices (id, question_id, text, sort_order)
      values (v_c, v_q, 'Choice ' || j, j);
      if j = 1 then v_first := v_c; end if;
    end loop;
    insert into public.quiz_answer_keys (question_id, correct_choice_id) values (v_q, v_first);
  end loop;
  if p_status <> 'draft' then
    update public.lessons set status = p_status where id = v_lesson;
  end if;
  return v_lesson;
end $$;

create or replace function tests.answers(p_lesson uuid, p_correct int)
returns jsonb language sql security definer set search_path = public, pg_temp as $$
  select coalesce(jsonb_agg(jsonb_build_object('question_id', q.id, 'choice_id',
    case when q.rn <= p_correct then k.correct_choice_id
         else (select c.id from quiz_choices c
               where c.question_id = q.id and c.id <> k.correct_choice_id
               order by c.sort_order limit 1) end)
    order by q.rn), '[]'::jsonb)
  from (select id, row_number() over (order by sort_order) rn
        from quiz_questions where lesson_id = p_lesson) q
  join quiz_answer_keys k on k.question_id = q.id
$$;

grant execute on all functions in schema tests to anon, authenticated;
